# Copy to .env.local for local development. ALL of these are server-only (no NEXT_PUBLIC_ prefix):
# the browser only ever talks to this portal's own origin, and the strict CSP (connect-src 'self')
# blocks anything else.
#
# Supabase project URL and its PUBLISHABLE key. Never put a service_role or sb_secret_ key here:
# the portal refuses to start if it finds one.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-the-publishable-key
# The Udofin API (services/api).
API_BASE_URL=http://localhost:8080
# This portal's own public origin (scheme + host, no path). Used for CSRF checks and cookies.
PORTAL_ORIGIN=http://localhost:3002
# Cookies are Secure (and __Host- prefixed) whenever PORTAL_ORIGIN is https. Set false ONLY for plain-http
# local development; it is refused in production.
# COOKIE_SECURE=false
# Trust X-Forwarded-For for rate limiting only when running behind a reverse proxy you control.
# TRUST_PROXY=false
