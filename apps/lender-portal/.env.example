# Copy to .env.local for local development.
# Server-only values (no NEXT_PUBLIC_ prefix) are never sent to browsers. The portals call the Udofin
# API from the Next.js server, and the strict CSP (connect-src 'self') blocks direct browser calls.
API_BASE_URL=http://localhost:8080
# Staff sign-in against Supabase Auth is added with the auth shell (Phase 03); its browser origin
# will then be added to connect-src deliberately, not by default.
