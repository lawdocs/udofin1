# Copy to .env.local for local development. EXPO_PUBLIC_* values are bundled into the app and are
# therefore PUBLIC. Never put service-role keys, provider secrets or signing keys here.
APP_ENV=local
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable (anon) key only — safe for clients because the database enforces RLS.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
