# Copy to .env.local. Everything here is PUBLIC: Expo inlines EXPO_PUBLIC_* values into the app bundle,
# so anyone with the app can read them. Never put a service_role or sb_secret_ key, a database URL or
# any other secret here: the app refuses to start if it finds a privileged Supabase key.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-the-publishable-key
