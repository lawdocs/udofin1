# Copy to .env for local development. Never commit real values.
APP_ENV=local
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Restricted database role for the API (NOT the postgres superuser, NOT service_role).
DATABASE_URL=postgres://udofin_api:change-me@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Comma-separated browser origins of the portals (https only when deployed).
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
TRUST_PROXY_HOPS=1
RATE_LIMIT_MAX_PER_MINUTE=120
