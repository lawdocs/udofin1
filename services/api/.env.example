# Copy to .env for local development. Never commit real values.
APP_ENV=local
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Restricted database role for the API (NOT the postgres superuser, NOT service_role).
DATABASE_URL=postgres://udofin_api:change-me@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Comma-separated browser origins of the portals (https only when deployed).
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
# Number of trusted reverse-proxy hops in front of the API. REQUIRED in staging and production (the API refuses
# to start without it; 0 only if the API is directly exposed). Too low: every client shares one rate-limit
# bucket. Too high: a client can choose its own address. Defaults to 0 in local and test.
TRUST_PROXY_HOPS=1
# Requests per minute per client address (all routes, before authentication).
RATE_LIMIT_MAX_PER_MINUTE=120
# Requests per minute per VERIFIED user across authenticated routes (routes with their own limit are also limited per user).
RATE_LIMIT_PRINCIPAL_MAX_PER_MINUTE=600
# Counters are kept in each API process: with several instances every limit is multiplied by the instance count.
# Worker and change-request application: the SYSTEM login (can only SET ROLE service_role). Different
# from DATABASE_URL on purpose; the API process itself does not need it.
# SYSTEM_DATABASE_URL=postgres://udofin_system:change-me@127.0.0.1:54322/postgres

# Borrower app (Phase 05). SMS_PROVIDER and INTEGRITY_PROVIDER accept only `none` or `mock`; `mock` is refused
# outside local and test. No real provider adapter exists yet (D-35, D-08), so deployed environments use `none`
# and the routes that need a provider say so honestly.
SMS_PROVIDER=none
INTEGRITY_PROVIDER=none
# Keys the hash of one-time step-up codes (32+ random characters, from a secrets manager). Required to start a step-up.
# STEPUP_OTP_PEPPER=
# Signing secret of the Supabase Send SMS hook (copy from the dashboard, form v1,whsec_...). Required to accept the hook.
# SEND_SMS_HOOK_SECRET=
